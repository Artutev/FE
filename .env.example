# Copy these variables to your environment before starting Django.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated domains/IPs the site is served on
ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
# Full origins (with scheme) for forms over HTTPS
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Set to True when nginx/Cloudflare terminates HTTPS in front of Django
BEHIND_HTTPS_PROXY=False
# Set to False only if the site is served over plain HTTP (cookies won't work otherwise)
SECURE_COOKIES=True
# Where collectstatic puts files (served by nginx)
# STATIC_ROOT=/var/www/fastevent/static

# Email. The first configured option wins:
# 0) Gmail API, 1) own mailbox over SMTP, 2) Resend, 3) Brevo, otherwise emails are printed to the console.

# 0) Gmail API over HTTPS (works when SMTP to Gmail is blocked). Get the values with:
#    python manage.py gmail_authorize --client-file client_secret.json   (see docs/DEPLOY.md)
# GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_SENDER=fastevent.123@gmail.com

# 1) Gmail mailbox fastevent.123@gmail.com (needs 2-Step Verification + an app password:
#    https://myaccount.google.com/apppasswords). SMTP host is picked automatically for @gmail.com.
EMAIL_HOST_USER=fastevent.123@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# 2) Resend
# RESEND_API_KEY=your-resend-api-key

# 3) Brevo
# BREVO_SMTP_LOGIN=your-brevo-login
# BREVO_SMTP_KEY=your-brevo-smtp-key

# Sender shown to recipients (defaults to "EventTown <EMAIL_HOST_USER>")
DEFAULT_FROM_EMAIL=EventTown <fastevent.123@gmail.com>
# Public site address, used for links in reminder emails sent by cron
SITE_URL=https://example.com

# PostgreSQL. When POSTGRES_DB is set, Django uses PostgreSQL instead of SQLite.
POSTGRES_DB=fastevent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional during local development:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend